# ============================================================================
# BREWLITE MONOREPO - GIT IGNORE CONFIGURATION
# ============================================================================

# Installed dependencies (root and workspaces)
node_modules/
*/node_modules/
/.pnp
.pnp.*

# Build output and caches
dist/
backend/dist/
frontend/.next/
frontend/out/
build/
*/build/
.cache/
.turbo/

# TypeScript build cache
*.tsbuildinfo
next-env.d.ts

# Logs & Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Test coverage
coverage/
*/coverage/
.nyc_output/
*.lcov

# Environment Variables (Bảo mật - tuyệt đối không commit file chứa credentials)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Local credentials and private keys
*.pem
*.key
.aws/

# IDE & Editor settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
.project
.classpath
.settings/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Deployment metadata
.vercel/
.netlify/

# Local database storage and backups (do not ignore Prisma migration SQL)
/pgdata/
/backups/
*.dump

# Temporary files
.tmp/
.temp/
*.tmp
