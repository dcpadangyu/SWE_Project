# ============================================================================
# BREWLITE MONOREPO - GIT IGNORE CONFIGURATION
# ============================================================================

# Dependencies
node_modules/
*/node_modules/
/.pnp
.pnp.*

# Build outputs
dist/
backend/dist/
frontend/.next/
frontend/out/
build/
*/build/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Logs & Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Test coverage
coverage/
*/coverage/
.nyc_output

# Environment Variables (Bảo mật - tuyệt đối không commit file chứa credentials)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# IDE & Editor settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
.project
.classpath
.settings/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker data volume directory (nếu mount cục bộ)
pgdata/
