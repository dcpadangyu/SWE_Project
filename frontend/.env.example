# ============================================================================
# BREWLITE FRONTEND (NEXT.JS) - BIẾN MÔI TRƯỜNG MẪU
# ============================================================================
# Sao chép tệp này thành .env.local trong thư mục frontend/ khi chạy phát triển.

# Địa chỉ endpoint của Backend NestJS API (mặc định cổng 8080 cục bộ)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Nếu truy cập FE qua tunnel, thay API URL ở trên bằng tunnel BE:
# NEXT_PUBLIC_API_URL=https://BACKEND-TUNNEL.trycloudflare.com
# Hostname của tunnel FE, không có https:// hoặc đường dẫn:
# DEV_TUNNEL_HOST=FRONTEND-TUNNEL.trycloudflare.com
