# ============================================================================
# BREWLITE MONOREPO - MẪU BIẾN MÔI TRƯỜNG DÙNG CHUNG (ROOT .ENV.EXAMPLE)
# ============================================================================
# Lưu ý: Tạo tệp .env tương ứng tại thư mục backend/ và frontend/ khi chạy local.
# Tuyệt đối KHÔNG commit tệp chứa thông tin bảo mật thực tế lên Git.

# ----------------------------------------------------------------------------
# 1. CẤU HÌNH BACKEND (NestJS API)
# ----------------------------------------------------------------------------
PORT=8080
# URL kết nối CSDL PostgreSQL cục bộ (khớp với container trong docker-compose.yml)
DATABASE_URL=postgresql://admin:admin111@localhost:5432/brewlite_db
# Chuỗi bí mật ký nhận JWT token (dành cho module Auth)
JWT_SECRET=super_secret_jwt_key_example_brewlite_2026
# Địa chỉ frontend được phép gọi API (CORS Origin)
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 2. CẤU HÌNH FRONTEND (Next.js PWA)
# ----------------------------------------------------------------------------
# Địa chỉ URL công khai của Backend NestJS API mà trình duyệt sẽ gửi request tới
NEXT_PUBLIC_API_URL=http://localhost:8080

# ----------------------------------------------------------------------------
# 3. CẤU HÌNH DOCKER COMPOSE (PostgreSQL Container)
# ----------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin111
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432
