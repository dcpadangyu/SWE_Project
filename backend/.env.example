# ============================================================================
# BREWLITE BACKEND (NESTJS) - BIẾN MÔI TRƯỜNG MẪU
# ============================================================================
# Sao chép tệp này thành .env trong thư mục backend/ khi chạy phát triển cục bộ.

# Cổng lắng nghe của NestJS API (khớp cấu hình trong main.ts và deployment.md)
PORT=8080

# Chuỗi kết nối cơ sở dữ liệu PostgreSQL cục bộ
DATABASE_URL=postgresql://admin:admin111@localhost:5432/brewlite_db

# Khóa bí mật dùng để mã hóa và ký JWT token
JWT_SECRET=super_secret_jwt_key_example_brewlite_2026

# Địa chỉ Frontend được cấp phép CORS (Next.js chạy ở cổng 3000)
FRONTEND_URL=http://localhost:3000
