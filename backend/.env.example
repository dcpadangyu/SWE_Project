# ============================================================================
# BREWLITE BACKEND (NESTJS) - BIẾN MÔI TRƯỜNG MẪU
# ============================================================================
# Sao chép tệp này thành .env trong thư mục backend/ khi chạy phát triển cục bộ.

# Cổng lắng nghe của NestJS API (khớp cấu hình trong main.ts và deployment.md)
PORT=8080

# Chuỗi kết nối cơ sở dữ liệu PostgreSQL cục bộ (cổng 5432 hoặc 5435 tùy docker-compose)
DATABASE_URL=postgresql://admin:admin111@localhost:5432/brewlite_db?schema=public

# Khóa bí mật dùng để mã hóa và ký JWT token
JWT_SECRET=super_secret_jwt_key_example_brewlite_2026

# Địa chỉ Frontend được cấp phép CORS (Next.js chạy ở cổng 3000)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Chỉ cần nhóm này khi bật VNPAY; thông tin sandbox do VNPay cấp, Git chỉ giữ placeholder.
VNPAY_TMN_CODE=ma_tmn_code_duoc_cap
VNPAY_HASH_SECRET=hash_secret_duoc_cap
VNPAY_HOST=https://sandbox.vnpayment.vn
VNPAY_TEST_MODE=true
# Tùy chọn: host API đối soát/hoàn tiền nếu VNPay cấp riêng; mặc định cùng VNPAY_HOST.
# VNPAY_QUERY_HOST=https://sandbox.vnpayment.vn

# MOCK để thử thanh toán local không cần merchant/key/tunnel, không thu tiền thật.
# Bật VNPAY sau khi cấu hình các biến bên trên và URL bên dưới; restart BE.
# Production bắt buộc VNPAY. FE tự đọc chế độ qua GET /payments/config.
PAYMENT_PROVIDER=MOCK

# Thay URL tunnel BE đang chạy; cập nhật IPN trên merchant riêng.
VNPAY_RETURN_URL=https://BACKEND-TUNNEL.trycloudflare.com/payments/vnpay/return
VNPAY_IPN_URL=https://BACKEND-TUNNEL.trycloudflare.com/payments/vnpay/ipn
