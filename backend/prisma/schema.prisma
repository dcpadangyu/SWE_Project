generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Model Danh mục
model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

// 2. Model Sản phẩm (Đồ uống) - Tuân thủ class-domain.md
model Product {
  id             String    @id @default(uuid())
  name           String
  description    String?
  imageUrl       String?
  
  // Giá theo 3 kích thước (S/M/L) - M là mặc định
  priceS         Decimal   @db.Decimal(10, 2)
  priceM         Decimal   @db.Decimal(10, 2)
  priceL         Decimal   @db.Decimal(10, 2)

  // Danh sách topping hợp lệ lưu dạng JSON: [{ id, name, price, isAvailable }]
  toppingOptions Json      @default("[]")

  // Tồn kho & trạng thái
  stock          Int       @default(0)
  isAvailable    Boolean   @default(true)
  
  // Dùng cho Optimistic Locking sau này
  version        Int       @default(0)

  // Khóa ngoại liên kết Danh mục
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])

  // Quan hệ ngược: các dòng đơn hàng tham chiếu tới sản phẩm này
  orderItems     OrderItem[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("products")
}

// 3. Kích thước đồ uống
enum Size {
  S
  M
  L
}

// 4. Trạng thái đơn hàng (State Machine - ADR-003)
enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

// 5. Đơn hàng - Tuân thủ class-domain.md (Order)
model Order {
  id             String      @id @default(uuid())
  // Mã đơn hiển thị cho khách: "#<orderNumber>" (ví dụ #1042)
  orderNumber    Int         @unique @default(autoincrement())

  // Chưa có quan hệ tới User vì bảng User thuộc Task 7 (Auth).
  // Khi Task 7 merge, thêm @relation tới User tại đây.
  userId         String

  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal     @db.Decimal(10, 2)
  voucherCode    String?
  note           String?

  // Idempotency-Key của lượt đặt hàng: gửi lại cùng khóa thì trả lại đơn cũ
  checkoutKey    String      @unique

  items          OrderItem[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, createdAt])
  @@map("orders")
}

// 6. Dòng món trong đơn - Tuân thủ class-domain.md (OrderDetail)
// Lưu bản chụp (snapshot) tên, topping, giá tại thời điểm đặt.
model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])

  productName      String
  size             Size
  quantity         Int
  selectedToppings Json    @default("[]")
  unitPrice        Decimal @db.Decimal(10, 2)
  subtotal         Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}