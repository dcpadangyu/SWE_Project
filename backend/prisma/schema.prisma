generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Model Danh mục
model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

// 2. Model Sản phẩm (Đồ uống)
model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?

  priceS Decimal @db.Decimal(10, 2)
  priceM Decimal @db.Decimal(10, 2)
  priceL Decimal @db.Decimal(10, 2)

  toppingOptions Json @default("[]")

  stock       Int     @default(0)
  isAvailable Boolean @default(true)

  version Int @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems  OrderItem[]
  recipeItems RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// 3. Phân quyền
enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

// 4. Model Người dùng
model User {
  id            String  @id @default(uuid())
  email         String  @unique
  passwordHash  String  @map("password_hash")
  fullName      String? @map("full_name")
  role          Role    @default(CUSTOMER)
  loyaltyPoints Int     @default(0) @map("loyalty_points")

  // Quan hệ: Một user có thể có nhiều đơn hàng và nhiều giao dịch điểm thưởng
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  refundRequests      RefundRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// 5. Kích thước
enum Size {
  S
  M
  L
}

// 6. Trạng thái đơn hàng
enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

// 7. Đơn hàng
model Order {
  id          String @id @default(uuid())
  orderNumber Int    @unique @default(autoincrement()) @map("order_number")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(10, 2)
  voucherCode    String?     @map("voucher_code")
  note           String?

  checkoutKey String @unique @map("checkout_key")

  items               OrderItem[]
  payments            Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  refundRequest       RefundRequest?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("orders")
}

// 8. Dòng món trong đơn
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  productName      String  @map("product_name")
  size             Size
  quantity         Int
  selectedToppings Json    @default("[]") @map("selected_toppings")
  unitPrice        Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal         Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

// 9. Phương thức thanh toán - Tuân thủ class-domain.md & sequence-checkout.md (Task 8)
enum PaymentMethod {
  E_WALLET
  BANK_CARD
}

// 10. Trạng thái thanh toán - Tuân thủ class-domain.md (Task 8)
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// 11. Giao dịch thanh toán - Tuân thủ class-domain.md (Payment) - Task 8 & Task 10
model Payment {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Thứ tự lần thử thanh toán từ 1 đến 3 (use case E3)
  attemptNumber   Int           @default(1) @map("attempt_number")

  // Idempotency-Key của lần thanh toán (chống thanh toán trùng - AC-13.4, Task 10.2)
  idempotencyKey  String        @unique @map("idempotency_key")

  paymentMethod   PaymentMethod @map("payment_method")
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)

  // Mã giao dịch từ cổng thanh toán (Mock Gateway)
  transactionCode String?       @map("transaction_code")
  errorMessage    String?       @map("error_message")
  errorCode       String?       @map("error_code")

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  completedAt     DateTime?     @map("completed_at")
  refundedAt      DateTime?     @map("refunded_at")

  // Nhà cung cấp thanh toán: MOCK hoặc VNPAY.
  provider String @default("MOCK")

  // Giữ URL để phát lại khi client gửi trùng Idempotency-Key.
  paymentUrl String? @map("payment_url")

  // Thời điểm hết hạn của URL thanh toán.
  expiresAt DateTime? @map("expires_at")

  @@unique([orderId, attemptNumber])
  @@index([orderId])
  @@map("payments")
}

// 12. Model Khuyến mãi (Voucher) - Tuân thủ class-domain.md (Task 7 & Task 10)
enum DiscountType {
  FIXED_AMOUNT
  PERCENTAGE
}

model Voucher {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)

  minOrderValue Decimal?     @map("min_order_value") @db.Decimal(10, 2)
  maxDiscount   Decimal?     @map("max_discount") @db.Decimal(10, 2)
  usageLimit    Int?         @map("usage_limit")
  usedCount     Int          @default(0) @map("used_count")
  startDate     DateTime?    @map("start_date")
  endDate       DateTime?    @map("end_date")

  isActive      Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vouchers")
}

// 13. Model Lịch sử điểm thưởng (LoyaltyTransaction) - Task 7
enum TransactionType {
  EARN
  REDEEM
}

model LoyaltyTransaction {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id])

  points Int
  type   TransactionType

  createdAt DateTime @default(now()) @map("created_at")

  @@map("loyalty_transactions")
}

// 14. Model Nguyên liệu (Ingredients)
model Ingredient {
  id           String       @id @default(uuid())
  name         String       @unique
  unit         String       // "g", "ml", "cái"
  stock        Decimal      @default(0) @db.Decimal(10, 2)
  minThreshold Decimal      @default(100) @map("min_threshold") @db.Decimal(10, 2)

  recipes      RecipeItem[]

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("ingredients")
}

// 15. Model Công thức định lượng theo sản phẩm và kích thước (Recipes)
model RecipeItem {
  id           String     @id @default(uuid())
  productId    String     @map("product_id")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  ingredientId String     @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  size         Size
  amount       Decimal    @db.Decimal(10, 2)

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([productId, ingredientId, size])
  @@map("recipe_items")
}

// 16. Model Yêu cầu hoàn tiền khi hủy đơn PAID (RefundRequest)
enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RefundRequest {
  id          String              @id @default(uuid())
  orderId     String              @unique @map("order_id")
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id])

  amount      Decimal             @db.Decimal(10, 2)
  reason      String?
  status      RefundRequestStatus @default(PENDING)

  processedBy String?             @map("processed_by")
  processedAt DateTime?           @map("processed_at")

  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("refund_requests")
}

// 17. Lịch sử biến động kho nguyên liệu (Audit Log)
enum IngredientLogAction {
  CREATE
  RESTOCK
  UPDATE
  DELETE
  ORDER_DEDUCT
}

model IngredientAuditLog {
  id             String              @id @default(uuid())
  ingredientId   String?             @map("ingredient_id")
  ingredientName String              @map("ingredient_name")
  action         IngredientLogAction
  changeAmount   Decimal?            @map("change_amount") @db.Decimal(10, 2)
  previousStock  Decimal?            @map("previous_stock") @db.Decimal(10, 2)
  newStock       Decimal?            @map("new_stock") @db.Decimal(10, 2)
  unit           String
  reason         String?
  performedBy    String?             @map("performed_by")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ingredient_audit_logs")
}

